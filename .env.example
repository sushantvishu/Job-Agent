# ============================================================
# Job Agent Framework — Environment Variables Template
# ============================================================
# 1. Copy this file to create your local .env:
#      cp .env.example .env     (Linux/macOS)
#      copy .env.example .env   (Windows)
# 2. Fill in your personal configuration below.
# 3. NEVER commit your live .env to Git — it is blocked by .gitignore.
# ============================================================

# ─── Candidate Information ──────────────────────────────────
CANDIDATE_NAME="Jane Doe"
CANDIDATE_EMAIL=jane.doe@example.com
CANDIDATE_PHONE="+1-555-000-1234"
RESUME_PATH=profile/resume.pdf
LINKEDIN_URL=https://www.linkedin.com/in/your-profile
GITHUB_URL=https://github.com/your-username
PORTFOLIO_URL=https://your-portfolio.dev

# ─── Target Job Preferences ─────────────────────────────────
TARGET_ROLE="Software Engineer"
TARGET_LOCATIONS="Remote, New York, San Francisco, Bengaluru"
EXPERIENCE_YEARS=2.0
NOTICE_PERIOD="Immediate"
EXPECTED_SALARY="Competitive"

# ─── Browser Automation (Selenium & Playwright) ─────────────
# Browser engine: "chrome" or "firefox"
BROWSER_TYPE=chrome
# Set "true" for headless background execution, "false" to view the browser
HEADLESS=false
BROWSER_TIMEOUT_SECONDS=30
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# ─── AI / LLM Integration ───────────────────────────────────
# Backend style: "ollama" (local) or "openai" (OpenAI-compatible)
AI_API_STYLE=ollama
OPENAI_API_KEY=your_openai_api_key_here
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:7b-instruct
LOCAL_AI_FALLBACK_MODELS=llama3.2:3b,qwen3:1.7b

# ─── Java Subprocess Bridge ─────────────────────────────────
JAVA_ENABLED=true
# Optional: path to Java installation (leave blank to use system PATH)
JAVA_HOME=
JAVA_BINARY=java

# ─── Database & Storage ─────────────────────────────────────
# Path to SQLite database file
DB_PATH=database/jobs.db

# ─── Logging & Auditing ─────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILENAME=job_agent.log

# ─── Optional Email Integration (Outreach & Monitoring) ──────
# Email IMAP / SMTP credentials:
# IMPORTANT: For Gmail or Google Workspace accounts, you MUST use a dedicated
# 16-character Google App Password (generate at https://myaccount.google.com/apppasswords).
# Standard Google account / workspace login passwords will be rejected by Google servers.
EMAIL_HOST=imap.gmail.com
EMAIL_USER=your_workspace_email@yourdomain.com
EMAIL_PASSWORD=your_16_character_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
OTP_EMAIL_ADDRESS=your_workspace_email@yourdomain.com
OTP_EMAIL_APP_PASSWORD=your_16_character_app_password

# ─── Optional CAPTCHA Solver ────────────────────────────────
CAPSOLVER_API_KEY=your_capsolver_api_key_here
